@@ -0,0 +1,26 @@
+#!/bin/sh
+
+#TEST_DIR="/tmp/sed_stdout_test_$$"
+#mkdir "$TEST_DIR"
+#cd "$TEST_DIR"
+
+echo "=== Creating test file ==="
+echo "line1: original content" > test_std.txt
+
+echo ""
+echo "=== Test 1: Standard stdout pipe (should NOT touch original file) ==="
