   branches_in_top_level = count_branches(the_program);
 #endif /*EXPERIMENTAL_DASH_N_OPTIMIZATION*/
+
+  /* If -i is enabled and we have actual file arguments (not stdin) */
+  if (in_place_extension && argv && *argv)
+    {
+      countT total_bad = 0;
+      char **cur_file;
+
+      for (cur_file = argv; *cur_file; cur_file++)
+        {
+          char *single_argv[2];
+          char tmp_name[1024];
+          char bak_name[1024];
+          FILE *fp_out;
+          int orig_stdout;
+
+          /* Skip standard input "-" for in-place editing */
+          if (strcmp(*cur_file, "-") == 0)
+            {
+              single_argv[0] = *cur_file;
+              single_argv[1] = NULL;
+              
+              input.file_list = single_argv;
+              input.bad_count = 0;
+              input.line_number = 0;
+              input.read_fn = read_always_fail;
+              input.fp = NULL;
+
+              line_init(&line, INITIAL_BUFFER_SIZE);
+              line_init(&hold, INITIAL_BUFFER_SIZE);
+              line_init(&buffer, FREAD_BUFFER_SIZE);
+
+              while (read_pattern_space(&input, 0))
+                {
+                  flagT quit = execute_program(the_program, &input);
+                  if (!no_default_output)
+                    output_line(line.text, line.length, line.chomped, stdout);
+                  if (quit)
+                    break;
+                }
+              closedown(&input);
+              total_bad += input.bad_count;
+              continue;
+            }
+
+          /* 1. Generate temp file name */
+          sprintf(tmp_name, "%s.tmpXXXXXX", *cur_file);
+          mktemp(tmp_name);
+
+          /* 2. Redirect stdout to temp file */
+          fflush(stdout);
+          orig_stdout = dup(fileno(stdout));
+          fp_out = fopen(tmp_name, "w");
+          if (!fp_out)
+            {
+              fprintf(stderr, "sed: cannot create temp file for %s\n", *cur_file);
+              total_bad++;
+              close(orig_stdout);
+              continue;
+            }
+          dup2(fileno(fp_out), fileno(stdout));
+
+          /* 3. Execute sed logic on single target file */
+          single_argv[0] = *cur_file;
+          single_argv[1] = NULL;
+
+          input.file_list = single_argv;
+          input.bad_count = 0;
+          input.line_number = 0;
+          input.read_fn = read_always_fail;
+          input.fp = NULL;
+
+          line_init(&line, INITIAL_BUFFER_SIZE);
+          line_init(&hold, INITIAL_BUFFER_SIZE);
+          line_init(&buffer, FREAD_BUFFER_SIZE);
+
+          while (read_pattern_space(&input, 0))
+            {
+              flagT quit = execute_program(the_program, &input);
+              if (!no_default_output)
+                output_line(line.text, line.length, line.chomped, stdout);
+              if (quit)
+                break;
+            }
+          closedown(&input);
+
+          /* 4. Flush and restore stdout */
+          fflush(stdout);
+          fclose(fp_out);
+          dup2(orig_stdout, fileno(stdout));
+          close(orig_stdout);
+
+          /* 5. Handle backup and swap temporary file */
+          if (input.bad_count == 0)
+            {
+              if (in_place_extension[0] != '\0')
+                {
+                  sprintf(bak_name, "%s%s", *cur_file, in_place_extension);
+                  unlink(bak_name);
+                  rename(*cur_file, bak_name);
+                }
+              else
+                {
+                  unlink(*cur_file);
+                }
+              rename(tmp_name, *cur_file);
+            }
+          else
+            {
+              unlink(tmp_name);
+            }
+
+          total_bad += input.bad_count;
+        }
+
+      return total_bad;
+    }
