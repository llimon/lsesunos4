diff -ruN sed-3.02/tests/test-no-change-i-test.sh sed-3.02-change-in-place/tests/test-no-change-i-test.sh
--- sed-3.02/tests/test-no-change-i-test.sh	Wed Dec 31 16:00:00 1969
