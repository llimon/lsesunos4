diff -ruN sed-3.02/tests/test-sed-i-inplace-edit.sh sed-3.02-change-in-place/tests/test-sed-i-inplace-edit.sh
--- sed-3.02/tests/test-sed-i-inplace-edit.sh	Wed Dec 31 16:00:00 1969
+++ sed-3.02-change-in-place/tests/test-sed-i-inplace-edit.sh	Mon Sep 28 10:18:35 1998
@@ -0,0 +1,52 @@
+#!/bin/sh
+
+# 1. Setup temporary test directory
+#TEST_DIR="/tmp/sed_test_$$"
+#mkdir "$TEST_DIR"
+#cd "$TEST_DIR"
+
+echo "=== Creating test files in $TEST_DIR ==="
+
+# 2. Create 3 files to be modified in-place
+echo "server1: status=down" > file1.txt
+echo "server2: status=down" > file2.txt
+echo "server3: status=down" > file3.txt
+
+# 3. Create a 4th file that should NOT be modified
+echo "server4: status=down" > skipme.log
+
+
+echo "Initial file states:"
+grep "status=" file*.txt skipme.log
+
+echo ""
+echo "=== Test 1: In-place edit across file1, file2, file3 (without backup) ==="
+
+# Run sed -i on only file1.txt, file2.txt, file3.txt
+../sed/sed -i 's/status=down/status=active/' file1.txt file2.txt file3.txt
+
+echo "Checking results:"
+grep "status=" file*.txt skipme.log
+
+echo ""
+echo "=== Test 2: In-place edit with backup extension (-i.bak) ==="
+
+# Run sed -i.bak to update 'active' to 'online' and generate .bak files
+../sed/sed -i.bak 's/status=active/status=online/' file1.txt file2.txt file3.txt
+
+echo "Checking modified files:"
+grep "status=" file1.txt file2.txt file3.txt
+
+echo ""
+echo "Checking generated backup (.bak) files:"
+grep "status=" *.bak
+
+echo ""
+echo "Verifying 4th file (skipme.log) remained untouched:"
+cat skipme.log
+
+# Cleanup
+#cd /tmp
+#rm -rf "$TEST_DIR"
+echo ""
+echo "=== Test Complete & Cleaned Up ==="
