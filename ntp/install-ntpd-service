#!/bin/sh

# Ensure we are running as root (UID 0)
if [ "$(id -u)" -ne 0 ]; then
    echo "Error: This script must be run as root." >&2
    exit 1
fi

RC_LOCAL="/etc/rc.local"
NTP_START_CMD="/usr/local/lse/bin/ntpd" # Adjust path if your ntpd binary lives elsewhere

# Check if rc.local exists, create if missing
if [ ! -f "$RC_LOCAL" ]; then
    echo "Creating $RC_LOCAL..."
    echo "#!/bin/sh" > "$RC_LOCAL"
    chmod 755 "$RC_LOCAL"
fi

# Check if the ntpd command is already in rc.local
if grep -q "ntpd" "$RC_LOCAL"; then
    echo "Notice: ntpd startup command already exists in $RC_LOCAL."
else
    echo "Adding ntpd startup command to $RC_LOCAL..."
    echo "" >> "$RC_LOCAL"
    echo "# Start NTP Daemon" >> "$RC_LOCAL"
    echo "if [ -x $NTP_START_CMD ]; then" >> "$RC_LOCAL"
    echo "    $NTP_START_CMD && echo ' - ntpd started'" >> "$RC_LOCAL"
    echo "fi" >> "$RC_LOCAL"
    echo "Successfully updated $RC_LOCAL."
fi
